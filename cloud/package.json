{
  "name": "westernis-cloud",
  "version": "1.0.0",
  "description": "Westernis on Cloudflare: the Worker (password gate with single sign-on, /images from R2) and the WikiContainer Durable Object that runs MediaWiki in a Cloudflare Container",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "dev": "wrangler dev --local-upstream localhost",
    "check": "wrangler deploy --dry-run --containers-rollout=none --outdir .wrangler/dry-run",
    "build:config": "node scripts/render-config.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
