#
# Westernis on Cloudflare: per-install settings (docs/cloudflare-design.md). Copy this file to .env.cloud
# (untracked: .gitignore excludes .env.*) and replace every <...> value. Never commit .env.cloud and
# never paste its values into a chat. One KEY=value per line, comments on their own lines.
#
#   pwsh cloud/scripts/Init-Cloud.ps1     renders cloud/wrangler.jsonc from the NON-SECRET keys below
#   pwsh cloud/scripts/Set-R2Keys.ps1     asks for the four R2 keys (hidden input) and tests them
#   pwsh cloud/scripts/Set-Secrets.ps1    asks for the gate password, fills the GATE/SESSION/API values
#                                         and sends every secret to the Worker (wrangler secret bulk)

# ---- Not secret: Init-Cloud.ps1 writes these into cloud/wrangler.jsonc -----------------------------------
# Cloudflare account ID (32 hex characters; dashboard -> Workers & Pages -> Account details)
CF_ACCOUNT_ID=<32 hex characters>
# Reading host (public later) and the always-private edit host. The edit host MUST be a subdomain of the
# reading host (e.g. wiki.example.org and edit.wiki.example.org): the gate's login cookie is set for the
# reading host's domain, so one login covers both.
WIKI_PUBLIC_HOST=<wiki.example.org>
WIKI_EDIT_HOST=<edit.wiki.example.org>
# The two private R2 buckets and their jurisdiction (owner decision: eu)
R2_DB_BUCKET=westernis-db
R2_MEDIA_BUCKET=westernis-media
R2_JURISDICTION=eu
# Optional: your PUBLIC ed25519 key (one line, "ssh-ed25519 AAAA... comment") for `wst.ps1 ssh`.
# Leave empty to deploy without SSH access.
SSH_PUBLIC_KEY=
# Optional: deploy an image that is already in the registry instead of building cloud/image/Dockerfile
# (then `wrangler deploy` needs no local Docker). List images: npx wrangler containers images list
CONTAINER_IMAGE=

# ---- SECRETS: R2 keys (Set-R2Keys.ps1 asks for them) -------------------------------------------------------
# R2 > Manage API tokens > Create Account API token, permission "Object Read & Write",
# "Apply to specific buckets only", ONE token per bucket.
R2_DB_ACCESS_KEY_ID=<westernis-db token: Access Key ID>
R2_DB_SECRET_ACCESS_KEY=<westernis-db token: Secret Access Key>
R2_MEDIA_ACCESS_KEY_ID=<westernis-media token: Access Key ID>
R2_MEDIA_SECRET_ACCESS_KEY=<westernis-media token: Secret Access Key>

# ---- SECRETS: written by Set-Secrets.ps1, leave them empty ------------------------------------------------
# GATE_PASSWORD_HASH  the gate password as "pbkdf2-sha256$100000$<salt base64>$<hash base64>" (the password
#                     itself is never stored). Set-Secrets.ps1 asks for a new password; Enter keeps this one.
#                     A new password signs every browser out.
# SESSION_SECRET      HMAC key of the login cookie (32 random bytes, base64url). Set-Secrets.ps1 -Rotate
#                     makes a new one, which also signs every browser out.
# API_TOKEN           token of non-browser clients (Forge MCP, wst.ps1 restart), header X-Westernis-Token.
#                     Set-Secrets.ps1 copies it into .env as WESTERNIS_API_TOKEN for the Forge client.
GATE_PASSWORD_HASH=
SESSION_SECRET=
API_TOKEN=
# GATE_USERS          guest logins, written by Add-WikiUser.ps1 (JSON list of login name, wiki user and
#                     password hash; no plain passwords). Guests type their name + password on the login page.
GATE_USERS=
