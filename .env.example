# Westernis configuration. Copy this file to .env (never commit .env) and replace every <...> value,
# or run  pwsh ./scripts/wiki.ps1 init  to create .env with fresh random secrets.
# Generate a secret by hand with  openssl rand -hex 32  or, in PowerShell 7:
#   [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
# ("-hex N" gives 2*N hex characters.) Keep comments on their own lines.

WIKI_SITENAME=Westernis
WIKI_LANG=de
WIKI_HOST_PORT=8088
# Canonical URL: http://localhost:8088 on this machine, or http://<your-LAN-IP>:8088 so other devices on your network get correct links
WIKI_SERVER=http://localhost:8088
WIKI_TIMEZONE=Europe/Berlin

# Database (created by the db container on its first start)
MARIADB_DATABASE=westernis
MARIADB_USER=westernis
MARIADB_PASSWORD=<openssl rand -hex 16>
MARIADB_ROOT_PASSWORD=<openssl rand -hex 16>

# MediaWiki secrets. WIKI_SECRET_KEY is required: the wiki refuses to start without it.
WIKI_SECRET_KEY=<openssl rand -hex 32>
WIKI_UPGRADE_KEY=<openssl rand -hex 8>

# Administrator account, created on the first `up`
WIKI_ADMIN_USER=Admin
WIKI_ADMIN_PASSWORD=<openssl rand -hex 10>

# Bot password for the Forge MCP server: MediaWiki requires at least 32 characters
WIKI_BOT_APPID=Forge
WIKI_BOT_PASSWORD=<openssl rand -hex 16>
# The MCP server talks to http://localhost:${WIKI_HOST_PORT}/api.php unless WIKI_API is set
# WIKI_API=http://localhost:8088/api.php

# 1 shows full exception details (stack traces, paths, SQL) on error pages: keep 0 on any public server
WIKI_DEBUG=0

# Optional: where visitors get the source code of the version you run (footer link, AGPL section 13).
# Defaults to the upstream repository; point it at your fork if you change the code.
# WIKI_SOURCE_URL=https://github.com/shiftbloom-studio/westernis
# Optional: licence notice for the wiki's own content in the footer (empty by default)
# WIKI_RIGHTS_URL=https://creativecommons.org/licenses/by-sa/4.0/
# WIKI_RIGHTS_TEXT=CC BY-SA 4.0
